{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgesentry.github.io/findura/schema/inspection_has_one_asset.schema.json",
  "title": "InspectionHasOneAssetShape",
  "description": "An inspection must have exactly one inspected asset.",
  "type": "object",
  "properties": {
    "inspection": {
      "type": "object",
      "required": ["inspected_assets"],
      "properties": {
        "inspected_assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
