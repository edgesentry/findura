{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgesentry.github.io/inspectra/schema/finding_has_deadline.schema.json",
  "title": "FindingHasDeadlineShape",
  "description": "Each Finding must have exactly one Deadline with due_on date specified.",
  "type": "object",
  "required": ["record_type"],
  "properties": {
    "record_type": { "type": "string" },
    "finding": {
      "type": "object",
      "required": ["deadlines"],
      "properties": {
        "deadlines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["due_on"],
            "properties": {
              "due_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "if": {
    "properties": { "record_type": { "const": "finding" } }
  },
  "then": {
    "required": ["finding"]
  }
}
